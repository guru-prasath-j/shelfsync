# Copy to cms/.env (git-ignored) for local runs. On Render, set these in the
# service's Environment tab instead.
#
# Razorpay test keys: Razorpay Dashboard -> switch to Test Mode ->
# Account & Settings -> API Keys -> Generate Test Key.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
